extends RefCounted
## Закулисье: ракета, коробки «ПРИЗЫ», прожектор. В финале ракету открывает игрок —
## здесь же тексты концовок (какая концовка — в GameState.finale_ending).


func rocket(d: DialogueBox) -> void:
	if GameState.finale_ending == "":
		await d.say("", "Большая картонная ракета с фестиваля «Космос». Дверца заклеена скотчем.")
		await d.say("", "Изнутри что-то тихо звякнуло… Или показалось?")
		if GameState.has_clue("manya") or GameState.has_clue("lenya"):
			await d.say("", "Та самая ракета, что на эскизе Мани и в нотах Лени!")
			await d.say("", "Но без доказательств её не откроешь. Расскажи разгадку на главной сцене.")
		else:
			await d.say("", "Надо бы узнать о ней побольше. Поспрашивай маскотов.")
		return

	# Финал: когда разговор закончится — экран итогов
	GameState.request_finale_summary()
	await d.say("", "Ты открываешь картонную ракету… Капсула Хотона внутри!")
	await d.say("", "Пластинка с «Ретро», красный нос с «Цирка», картонный шлем с «Космоса» — всё на месте.")
	if GameState.finale_ending == "festival":
		await d.say("Маня", "Ой, солнышко, ты её нашёл! Фестиваль открывается!")
		await d.say("", "Музыка, огни, гости… А в тени кулис кто-то с рогами довольно кивает.")
		await d.say("", "Кто это был? Это так и осталось загадкой…")
		return

	await d.say("Сулус", "Браво, детектив! Признаюсь, Капсулу спрятал я.")
	await d.say("Сулус", "Фестиваль «Детектив» должен начинаться с настоящей загадки. Это была проверка, и вы её прошли!")
	await d.say("Сулус", "Объявляю вас почётным детективом Хотона!")
	await d.say("", "Ты кладёшь лупу в Капсулу, рядом с пластинкой, красным носом и картонным шлемом.")
	if GameState.finale_ending == "perfect":
		await d.say("Сулус", "И ещё кое-что, коллега. У Капсулы двойное дно.")
		await d.say("", "Внутри старое письмо с самого первого фестиваля Хотона, 2023 года. Маскоты читают его вместе и улыбаются.")
		await d.say("", "Твоё имя впишут в Книгу детективов Хотона.")
	elif GameState.finale_why:
		await d.say("Сулус", "Впрочем, кое-какие секреты наши друзья вам ещё не рассказали…")


func crates(d: DialogueBox) -> void:
	if GameState.has_stamp("moyto"):
		await d.say("", "Коробки с надписью «ПРИЗЫ». Вот что прятал Мойто! Сюрприз для конкурсов.")
	else:
		await d.say("", "Коробки с надписью «ПРИЗЫ». Мойто с утра так нервничал… Может, он прятал именно их?")


func spotlight(d: DialogueBox) -> void:
	await d.say("", "Прожектор для концертов Лени. Сейчас выключен, ракета стоит в тени.")
